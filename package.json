{
  "name": "alejosorno-dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint src tests scripts \"*.{js,mjs,ts}\"",
    "format": "prettier --write src tests scripts .github \"*.{js,mjs,ts,json}\" .prettierrc.json",
    "format:check": "prettier --check src tests scripts .github \"*.{js,mjs,ts,json}\" .prettierrc.json",
    "content:validate": "astro sync",
    "docs:validate": "node scripts/docs/validate.ts",
    "docs:manifest": "node scripts/docs/manifest.ts",
    "test:unit": "vitest run",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm content:validate && pnpm docs:validate && pnpm test:unit",
    "test:perf": "node scripts/budget.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@astrojs/vercel": "11.0.22",
    "astro": "7.4.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
